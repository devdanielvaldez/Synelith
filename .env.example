# ==============================================================================
# NeuroGenesis AI - Environment Configuration Template
# Copy to .env for local development: cp .env.example .env
# ==============================================================================

# Database (PostgreSQL + pgvector)
POSTGRES_DB=neurogenesis
POSTGRES_USER=neurogenesis
POSTGRES_PASSWORD=neurogenesis_dev_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://neurogenesis:neurogenesis_dev_pass@localhost:5432/neurogenesis

# Object Storage (MinIO / S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET_PAPERS=neurogenesis-papers
S3_BUCKET_ARTIFACTS=neurogenesis-artifacts

# Biomedical APIs (Optional keys for higher rate limits)
NCBI_API_KEY=
EUROPE_PMC_EMAIL=

# API & Gateway Settings
API_ENV=development
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Security & Sandboxing
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_LIMIT_MB=2048
